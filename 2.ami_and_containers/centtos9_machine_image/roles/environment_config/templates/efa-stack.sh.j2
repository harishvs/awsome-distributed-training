#!/bin/bash
# /etc/profile.d/efa-stack.sh
# EFA Stack Environment Configuration
# Generated by Ansible environment_config role
#
# Requirements:
# - 13.1: Create /etc/profile.d/ scripts for all installed components
# - 13.2: Configure LD_LIBRARY_PATH to include all library paths
# - 13.3: Configure PATH to include all binary paths
# - 13.4: Configure CPATH to include all header paths

# CUDA
export CUDA_HOME={{ env_cuda_home }}
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH={{ env_cuda_lib }}:{{ env_cuda_cupti_lib }}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export CPATH={{ env_cuda_include }}${CPATH:+:$CPATH}

# GDRCopy
export PATH={{ env_gdrcopy_bin }}:$PATH
export LD_LIBRARY_PATH={{ env_gdrcopy_lib }}:$LD_LIBRARY_PATH
export CPATH={{ env_gdrcopy_include }}:$CPATH

# Hwloc
export PATH={{ env_hwloc_bin }}:$PATH
export LD_LIBRARY_PATH={{ env_hwloc_lib }}:$LD_LIBRARY_PATH

# EFA/Libfabric
export PATH={{ env_efa_bin }}:$PATH
export LD_LIBRARY_PATH={{ env_efa_lib }}:$LD_LIBRARY_PATH
export FI_PROVIDER={{ env_fi_provider }}

# NCCL
export LD_LIBRARY_PATH={{ env_nccl_lib }}:$LD_LIBRARY_PATH
export NCCL_PROTO={{ env_nccl_proto }}

# AWS OFI NCCL
export LD_LIBRARY_PATH={{ env_aws_ofi_nccl_lib }}:$LD_LIBRARY_PATH

# NCCL Tests
export PATH={{ env_nccl_tests_bin }}:$PATH
